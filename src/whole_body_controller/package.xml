<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
    <name>whole_body_controller</name>
    <version>0.1.0</version>
    <description>Whole-body coordinator for mobile dual-arm manipulation.</description>
    <maintainer email="d570737261@163.com">dyk</maintainer>
    <license>MIT</license>

    <buildtool_depend>ament_cmake</buildtool_depend>

    <depend>rclcpp</depend>
    <depend>geometry_msgs</depend>
    <depend>std_msgs</depend>
    <depend>tf2</depend>
    <depend>tf2_geometry_msgs</depend>
    <depend>tf2_ros</depend>

    <exec_depend>arm_controller</exec_depend>
    <exec_depend>chassis_controller</exec_depend>

    <export>
        <build_type>ament_cmake</build_type>
    </export>
</package>
