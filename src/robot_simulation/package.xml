<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
    <name>robot_simulation</name>
    <version>0.1.0</version>
    <description>Gazebo simulation launch and controller configuration for the mobile manipulator.</description>
    <maintainer email="d570737261@163.com">dyk</maintainer>
    <license>MIT</license>

    <buildtool_depend>ament_cmake</buildtool_depend>

    <exec_depend>chassis_controller</exec_depend>
    <exec_depend>controller_manager</exec_depend>
    <exec_depend>gazebo_msgs</exec_depend>
    <exec_depend>gazebo_ros</exec_depend>
    <exec_depend>gazebo_ros2_control</exec_depend>
    <exec_depend>geometry_msgs</exec_depend>
    <exec_depend>joint_state_broadcaster</exec_depend>
    <exec_depend>rclpy</exec_depend>
    <exec_depend>robot_state_publisher</exec_depend>
    <exec_depend>robot_description</exec_depend>
    <exec_depend>ros2_controllers</exec_depend>
    <exec_depend>std_msgs</exec_depend>
    <exec_depend>sensor_msgs</exec_depend>
    <exec_depend>tf2_ros</exec_depend>
    <exec_depend>whole_body_description</exec_depend>
    <exec_depend>xacro</exec_depend>

    <test_depend>ament_lint_auto</test_depend>
    <test_depend>ament_lint_common</test_depend>

    <export>
        <build_type>ament_cmake</build_type>
    </export>
</package>
