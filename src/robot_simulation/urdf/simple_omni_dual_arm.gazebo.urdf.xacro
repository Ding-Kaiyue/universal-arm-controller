<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="simple_omni_dual_arm_gazebo">
    <xacro:include filename="$(find whole_body_description)/urdf/simple_omni_dual_arm.urdf" />

    <ros2_control name="GazeboSystem" type="system">
        <hardware>
            <plugin>gazebo_ros2_control/GazeboSystem</plugin>
        </hardware>

        <joint name="front_left_wheel_joint">
            <command_interface name="velocity" />
            <state_interface name="position">
                <param name="initial_value">0.0</param>
            </state_interface>
            <state_interface name="velocity" />
        </joint>
        <joint name="front_right_wheel_joint">
            <command_interface name="velocity" />
            <state_interface name="position">
                <param name="initial_value">0.0</param>
            </state_interface>
            <state_interface name="velocity" />
        </joint>
        <joint name="rear_left_wheel_joint">
            <command_interface name="velocity" />
            <state_interface name="position">
                <param name="initial_value">0.0</param>
            </state_interface>
            <state_interface name="velocity" />
        </joint>
        <joint name="rear_right_wheel_joint">
            <command_interface name="velocity" />
            <state_interface name="position">
                <param name="initial_value">0.0</param>
            </state_interface>
            <state_interface name="velocity" />
        </joint>

        <joint name="left_joint1">
            <command_interface name="velocity" />
            <state_interface name="position">
                <param name="initial_value">0.707</param>
            </state_interface>
            <state_interface name="velocity" />
        </joint>
        <joint name="left_joint2">
            <command_interface name="velocity" />
            <state_interface name="position">
                <param name="initial_value">-0.5236</param>
            </state_interface>
            <state_interface name="velocity" />
        </joint>
        <joint name="left_joint3">
            <command_interface name="velocity" />
            <state_interface name="position">
                <param name="initial_value">-0.7854</param>
            </state_interface>
            <state_interface name="velocity" />
        </joint>
        <joint name="left_joint4">
            <command_interface name="velocity" />
            <state_interface name="position">
                <param name="initial_value">0.0</param>
            </state_interface>
            <state_interface name="velocity" />
        </joint>
        <joint name="left_joint5">
            <command_interface name="velocity" />
            <state_interface name="position">
                <param name="initial_value">0.5236</param>
            </state_interface>
            <state_interface name="velocity" />
        </joint>
        <joint name="left_joint6">
            <command_interface name="velocity" />
            <state_interface name="position">
                <param name="initial_value">0.0</param>
            </state_interface>
            <state_interface name="velocity" />
        </joint>

        <joint name="right_joint1">
            <command_interface name="velocity" />
            <state_interface name="position">
                <param name="initial_value">-0.707</param>
            </state_interface>
            <state_interface name="velocity" />
        </joint>
        <joint name="right_joint2">
            <command_interface name="velocity" />
            <state_interface name="position">
                <param name="initial_value">0.5236</param>
            </state_interface>
            <state_interface name="velocity" />
        </joint>
        <joint name="right_joint3">
            <command_interface name="velocity" />
            <state_interface name="position">
                <param name="initial_value">0.7854</param>
            </state_interface>
            <state_interface name="velocity" />
        </joint>
        <joint name="right_joint4">
            <command_interface name="velocity" />
            <state_interface name="position">
                <param name="initial_value">0.0</param>
            </state_interface>
            <state_interface name="velocity" />
        </joint>
        <joint name="right_joint5">
            <command_interface name="velocity" />
            <state_interface name="position">
                <param name="initial_value">-0.5236</param>
            </state_interface>
            <state_interface name="velocity" />
        </joint>
        <joint name="right_joint6">
            <command_interface name="velocity" />
            <state_interface name="position">
                <param name="initial_value">0.0</param>
            </state_interface>
            <state_interface name="velocity" />
        </joint>

        <joint name="left_hand_narrow1_joint">
            <state_interface name="position">
                <param name="initial_value">0.0</param>
            </state_interface>
            <state_interface name="velocity" />
        </joint>
        <joint name="left_hand_narrow2_joint">
            <state_interface name="position">
                <param name="initial_value">0.0</param>
            </state_interface>
            <state_interface name="velocity" />
        </joint>
        <joint name="left_hand_narrow3_joint">
            <state_interface name="position">
                <param name="initial_value">0.0</param>
            </state_interface>
            <state_interface name="velocity" />
        </joint>
        <joint name="left_hand_narrow_loop_joint">
            <state_interface name="position">
                <param name="initial_value">0.0</param>
            </state_interface>
            <state_interface name="velocity" />
        </joint>
        <joint name="left_hand_wide1_joint">
            <state_interface name="position">
                <param name="initial_value">0.0</param>
            </state_interface>
            <state_interface name="velocity" />
        </joint>
        <joint name="left_hand_wide2_joint">
            <state_interface name="position">
                <param name="initial_value">0.0</param>
            </state_interface>
            <state_interface name="velocity" />
        </joint>
        <joint name="left_hand_wide3_joint">
            <state_interface name="position">
                <param name="initial_value">0.0</param>
            </state_interface>
            <state_interface name="velocity" />
        </joint>
        <joint name="left_hand_wide_loop_joint">
            <state_interface name="position">
                <param name="initial_value">0.0</param>
            </state_interface>
            <state_interface name="velocity" />
        </joint>

        <joint name="right_hand_narrow1_joint">
            <state_interface name="position">
                <param name="initial_value">0.0</param>
            </state_interface>
            <state_interface name="velocity" />
        </joint>
        <joint name="right_hand_narrow2_joint">
            <state_interface name="position">
                <param name="initial_value">0.0</param>
            </state_interface>
            <state_interface name="velocity" />
        </joint>
        <joint name="right_hand_narrow3_joint">
            <state_interface name="position">
                <param name="initial_value">0.0</param>
            </state_interface>
            <state_interface name="velocity" />
        </joint>
        <joint name="right_hand_narrow_loop_joint">
            <state_interface name="position">
                <param name="initial_value">0.0</param>
            </state_interface>
            <state_interface name="velocity" />
        </joint>
        <joint name="right_hand_wide1_joint">
            <state_interface name="position">
                <param name="initial_value">0.0</param>
            </state_interface>
            <state_interface name="velocity" />
        </joint>
        <joint name="right_hand_wide2_joint">
            <state_interface name="position">
                <param name="initial_value">0.0</param>
            </state_interface>
            <state_interface name="velocity" />
        </joint>
        <joint name="right_hand_wide3_joint">
            <state_interface name="position">
                <param name="initial_value">0.0</param>
            </state_interface>
            <state_interface name="velocity" />
        </joint>
        <joint name="right_hand_wide_loop_joint">
            <state_interface name="position">
                <param name="initial_value">0.0</param>
            </state_interface>
            <state_interface name="velocity" />
        </joint>
    </ros2_control>

    <gazebo>
        <plugin filename="libgazebo_ros_planar_move.so" name="gazebo_ros_planar_move">
            <ros>
                <remapping>cmd_vel:=cmd_vel</remapping>
                <remapping>odom:=odom</remapping>
            </ros>
            <update_rate>100</update_rate>
            <publish_rate>50</publish_rate>
            <publish_odom>true</publish_odom>
            <publish_odom_tf>false</publish_odom_tf>
            <odometry_frame>odom</odometry_frame>
            <robot_base_frame>base_footprint</robot_base_frame>
            <covariance_x>0.0001</covariance_x>
            <covariance_y>0.0001</covariance_y>
            <covariance_yaw>0.01</covariance_yaw>
        </plugin>
        <plugin filename="libgazebo_ros2_control.so" name="gazebo_ros2_control">
            <parameters>$(find robot_simulation)/config/simple_omni_base_controllers.yaml</parameters>
        </plugin>
    </gazebo>

    <link name="gazebo_depth_camera_link">
        <inertial>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <mass value="0.08" />
            <inertia ixx="0.00002" ixy="0" ixz="0" iyy="0.00002" iyz="0" izz="0.00002" />
        </inertial>
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                <box size="0.05 0.035 0.03" />
            </geometry>
            <material name="camera_black">
                <color rgba="0.02 0.02 0.02 1.0" />
            </material>
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                <box size="0.05 0.035 0.03" />
            </geometry>
        </collision>
    </link>

    <joint name="center_column_to_gazebo_depth_camera" type="fixed">
        <origin xyz="0.105 0 0.65" rpy="0 0 0" />
        <parent link="center_column_link" />
        <child link="gazebo_depth_camera_link" />
    </joint>

    <link name="gazebo_depth_camera_optical_frame" />

    <joint name="gazebo_depth_camera_to_optical_frame" type="fixed">
        <origin xyz="0 0 0" rpy="-1.57079632679 0 -1.57079632679" />
        <parent link="gazebo_depth_camera_link" />
        <child link="gazebo_depth_camera_optical_frame" />
    </joint>

    <gazebo reference="gazebo_depth_camera_link">
        <material>Gazebo/Black</material>
        <gravity>false</gravity>
        <sensor type="depth" name="gazebo_depth_camera">
            <update_rate>20</update_rate>
            <visualize>true</visualize>
            <camera>
                <horizontal_fov>1.5708</horizontal_fov>
                <image>
                    <width>320</width>
                    <height>240</height>
                    <format>B8G8R8</format>
                </image>
                <depth_camera />
                <clip>
                    <near>0.08</near>
                    <far>5.00</far>
                </clip>
            </camera>
            <plugin name="gazebo_depth_camera_controller" filename="libgazebo_ros_camera.so">
                <ros>
                    <namespace>/gazebo_depth_camera</namespace>
                    <remapping>gazebo_depth_camera/points:=points</remapping>
                    <remapping>gazebo_depth_camera/depth/image_raw:=depth/image_raw</remapping>
                    <remapping>gazebo_depth_camera/depth/camera_info:=depth/camera_info</remapping>
                    <remapping>gazebo_depth_camera/image_raw:=image_raw</remapping>
                    <remapping>gazebo_depth_camera/camera_info:=camera_info</remapping>
                </ros>
                <camera_name>gazebo_depth_camera</camera_name>
                <frame_name>gazebo_depth_camera_optical_frame</frame_name>
                <min_depth>0.08</min_depth>
                <max_depth>5.00</max_depth>
            </plugin>
        </sensor>
    </gazebo>
</robot>
