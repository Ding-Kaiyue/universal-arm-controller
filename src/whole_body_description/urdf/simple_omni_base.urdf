<?xml version="1.0" encoding="utf-8"?>
<robot name="simple_omni_base">
    <material name="base_gray">
        <color rgba="0.45 0.48 0.52 1.0" />
    </material>
    <material name="wheel_black">
        <color rgba="0.02 0.02 0.02 1.0" />
    </material>
    <material name="roller_blue">
        <color rgba="0.12 0.34 0.85 1.0" />
    </material>

    <link name="base_footprint" />

    <joint name="base_footprint_to_base_link" type="fixed">
        <origin xyz="0 0 -0.01" rpy="0 0 0" />
        <parent link="base_footprint" />
        <child link="base_link" />
    </joint>

    <link name="base_link">
        <inertial>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <mass value="20.0" />
            <inertia
                ixx="0.293333333333"
                ixy="0"
                ixz="0"
                iyy="0.293333333333"
                iyz="0"
                izz="0.666666666667" />
        </inertial>
        <visual>
            <origin xyz="0 0 0.24" rpy="0 0 0" />
            <geometry>
                <box size="0.56 0.56 0.16" />
            </geometry>
            <material name="base_gray" />
        </visual>
        <collision>
            <origin xyz="0 0 0.24" rpy="0 0 0" />
            <geometry>
                <box size="0.56 0.56 0.16" />
            </geometry>
        </collision>
    </link>

    <link name="front_left_wheel_link">
        <inertial>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <mass value="1.0" />
            <inertia
                ixx="0.001575"
                ixy="0"
                ixz="0"
                iyy="0.0028125"
                iyz="0"
                izz="0.001575" />
        </inertial>
        <visual>
            <origin xyz="0 0 0" rpy="1.5707963267949 0 0" />
            <geometry>
                <cylinder radius="0.075" length="0.045" />
            </geometry>
            <material name="wheel_black" />
        </visual>
        <visual>
            <origin xyz="0 0.026 0" rpy="0 0 0" />
            <geometry>
                <sphere radius="0.013" />
            </geometry>
            <material name="roller_blue" />
        </visual>
        <visual>
            <origin xyz="0 -0.026 0" rpy="0 0 0" />
            <geometry>
                <sphere radius="0.013" />
            </geometry>
            <material name="roller_blue" />
        </visual>
    </link>

    <joint name="front_left_wheel_joint" type="continuous">
        <origin xyz="0.20 0.20 0.085" rpy="0 0 -0.785398163397" />
        <parent link="base_link" />
        <child link="front_left_wheel_link" />
        <axis xyz="0 1 0" />
        <limit effort="40" velocity="80" />
        <dynamics damping="0.02" friction="0.0" />
    </joint>

    <link name="front_right_wheel_link">
        <inertial>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <mass value="1.0" />
            <inertia
                ixx="0.001575"
                ixy="0"
                ixz="0"
                iyy="0.0028125"
                iyz="0"
                izz="0.001575" />
        </inertial>
        <visual>
            <origin xyz="0 0 0" rpy="1.5707963267949 0 0" />
            <geometry>
                <cylinder radius="0.075" length="0.045" />
            </geometry>
            <material name="wheel_black" />
        </visual>
        <visual>
            <origin xyz="0 0.026 0" rpy="0 0 0" />
            <geometry>
                <sphere radius="0.013" />
            </geometry>
            <material name="roller_blue" />
        </visual>
        <visual>
            <origin xyz="0 -0.026 0" rpy="0 0 0" />
            <geometry>
                <sphere radius="0.013" />
            </geometry>
            <material name="roller_blue" />
        </visual>
    </link>

    <joint name="front_right_wheel_joint" type="continuous">
        <origin xyz="0.20 -0.20 0.085" rpy="0 0 0.785398163397" />
        <parent link="base_link" />
        <child link="front_right_wheel_link" />
        <axis xyz="0 1 0" />
        <limit effort="40" velocity="80" />
        <dynamics damping="0.02" friction="0.0" />
    </joint>

    <link name="rear_left_wheel_link">
        <inertial>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <mass value="1.0" />
            <inertia
                ixx="0.001575"
                ixy="0"
                ixz="0"
                iyy="0.0028125"
                iyz="0"
                izz="0.001575" />
        </inertial>
        <visual>
            <origin xyz="0 0 0" rpy="1.5707963267949 0 0" />
            <geometry>
                <cylinder radius="0.075" length="0.045" />
            </geometry>
            <material name="wheel_black" />
        </visual>
        <visual>
            <origin xyz="0 0.026 0" rpy="0 0 0" />
            <geometry>
                <sphere radius="0.013" />
            </geometry>
            <material name="roller_blue" />
        </visual>
        <visual>
            <origin xyz="0 -0.026 0" rpy="0 0 0" />
            <geometry>
                <sphere radius="0.013" />
            </geometry>
            <material name="roller_blue" />
        </visual>
    </link>

    <joint name="rear_left_wheel_joint" type="continuous">
        <origin xyz="-0.20 0.20 0.085" rpy="0 0 0.785398163397" />
        <parent link="base_link" />
        <child link="rear_left_wheel_link" />
        <axis xyz="0 1 0" />
        <limit effort="40" velocity="80" />
        <dynamics damping="0.02" friction="0.0" />
    </joint>

    <link name="rear_right_wheel_link">
        <inertial>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <mass value="1.0" />
            <inertia
                ixx="0.001575"
                ixy="0"
                ixz="0"
                iyy="0.0028125"
                iyz="0"
                izz="0.001575" />
        </inertial>
        <visual>
            <origin xyz="0 0 0" rpy="1.5707963267949 0 0" />
            <geometry>
                <cylinder radius="0.075" length="0.045" />
            </geometry>
            <material name="wheel_black" />
        </visual>
        <visual>
            <origin xyz="0 0.026 0" rpy="0 0 0" />
            <geometry>
                <sphere radius="0.013" />
            </geometry>
            <material name="roller_blue" />
        </visual>
        <visual>
            <origin xyz="0 -0.026 0" rpy="0 0 0" />
            <geometry>
                <sphere radius="0.013" />
            </geometry>
            <material name="roller_blue" />
        </visual>
    </link>

    <joint name="rear_right_wheel_joint" type="continuous">
        <origin xyz="-0.20 -0.20 0.085" rpy="0 0 -0.785398163397" />
        <parent link="base_link" />
        <child link="rear_right_wheel_link" />
        <axis xyz="0 1 0" />
        <limit effort="40" velocity="80" />
        <dynamics damping="0.02" friction="0.0" />
    </joint>

    <gazebo reference="base_link">
        <material>Gazebo/Grey</material>
        <gravity>false</gravity>
    </gazebo>
    <gazebo reference="front_left_wheel_link">
        <material>Gazebo/Black</material>
        <gravity>false</gravity>
        <mu1>1.0</mu1>
        <mu2>1.0</mu2>
    </gazebo>
    <gazebo reference="front_right_wheel_link">
        <material>Gazebo/Black</material>
        <gravity>false</gravity>
        <mu1>1.0</mu1>
        <mu2>1.0</mu2>
    </gazebo>
    <gazebo reference="rear_left_wheel_link">
        <material>Gazebo/Black</material>
        <gravity>false</gravity>
        <mu1>1.0</mu1>
        <mu2>1.0</mu2>
    </gazebo>
    <gazebo reference="rear_right_wheel_link">
        <material>Gazebo/Black</material>
        <gravity>false</gravity>
        <mu1>1.0</mu1>
        <mu2>1.0</mu2>
    </gazebo>
</robot>
